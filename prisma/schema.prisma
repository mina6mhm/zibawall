generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  PENDING_PAYMENT
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderRole {
  USER
  ADMIN
}

enum GenderAudience {
  FEMALE
  MALE
  BOTH
}

enum BookingStatus {
  PENDING_PAYMENT // مشتری مراحل انتخاب رو تموم کرده، منتظر واریز بیعانه‌ست
  CONFIRMED       // بیعانه واریز شد، نوبت قطعیه
  CANCELLED       // لغو شده
}

model Salon {
  id                    String      @id @default(uuid())
  name                  String
  province              String
  city                  String
  district              String?
  neighborhoods         String[]
  address               String
  lat                   Float?
  lng                   Float?
  phones                String[]
  workingHours          String
  closedDays            String[]

  hasHomeService         Boolean        @default(false)
  genderAudience         GenderAudience @default(BOTH)

  rating                Float       @default(0)
  reviewsCount          Int         @default(0)

  tags                  Json        @default("[]")
  imageUrl              String
  description           String
  portfolios            String[]

  status                SalonStatus @default(PENDING_PAYMENT)
  planId                String?
  subscriptionExpiresAt DateTime?
  reminderSentAt        DateTime?

  // نوبت‌دهی آنلاین: کاملاً اختیاری و سمت سالن‌دار روشن/خاموش می‌شود
  bookingEnabled        Boolean     @default(false)

  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  socials               Social?
  reviews               Review[]
  payments              Payment[]
  visits                Visit[]
  staff                 Staff[]

  bookingCategories      BookingCategory[]
  bookingServices        BookingService[]
  bookings                Booking[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([status, subscriptionExpiresAt])
  @@index([hasHomeService])
  @@index([genderAudience])
}

model Staff {
  id        String   @id @default(uuid())
  name      String

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // پرسنل می‌تواند در چند دسته‌ی خدمات فعالیت کند
  categories BookingCategory[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, name])
  @@index([salonId])
}

model Social {
  id        String  @id @default(uuid())
  website   String?
  instagram String?
  whatsapp  String?
  telegram  String?
  rubika    String?
  bale      String?

  salonId   String  @unique
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Float
  comment   String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String?
  username      String?  @unique
  phone         String?  @unique
  email         String?  @unique

  passwordHash  String?

  role          String   @default("USER")

  otpCode       String?
  otpExpiresAt  DateTime?

  salon         Salon?

  supportMessages SupportMessage[]
  bookings        Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  status    PaymentStatus @default(PENDING)
  planId    String

  authority String?       @unique
  refId     String?

  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SupportMessage {
  id          String        @id @default(uuid())
  message     String
  status      SupportStatus @default(PENDING)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  name        String?
  hadSalon    Boolean       @default(false)
  salonId     String?
  salonName   String?

  adminReply  String?
  repliedAt   DateTime?

  seenByUser  Boolean       @default(true)
  seenByAdmin Boolean       @default(true)

  replies     SupportReply[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([userId, seenByUser])
  @@index([seenByAdmin])
}

model SupportReply {
  id        String     @id @default(uuid())
  message   String
  sender    SenderRole

  ticketId  String
  ticket    SupportMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([ticketId])
}

model Visit {
  id            String        @id @default(uuid())
  customerPhone String
  customerName  String?

  visitDate     DateTime
  checkInTime   String?
  checkOutTime  String?

  services      Json          @default("[]")
  totalAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  authority     String?       @unique
  refId         String?

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerPhone])
  @@index([paymentStatus])
}

// دسته‌ی خدمات نوبت‌دهی — کاملاً توسط خود سالن‌دار تعریف می‌شود، هیچ وابستگی به دیتای پیش‌فرض سایت ندارد
model BookingCategory {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  services  BookingService[]
  staff     Staff[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, name])
  @@index([salonId])
}

// ریزخدمت داخل هر دسته — مثلاً «کاشت ناخن» زیر دسته‌ی «خدمات ناخن»
model BookingService {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int      // اجباری، برای محاسبه‌ی تداخل زمانی لازم است
  price           Int?     // اختیاری
  order           Int      @default(0)

  categoryId      String
  category        BookingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  bookings        Booking[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([salonId])
}

// یک نوبت نهایی مشتری
model Booking {
  id            String        @id @default(uuid())
  status        BookingStatus @default(PENDING_PAYMENT)

  customerId    String
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  categoryId    String?
  category      BookingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       BookingService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId       String?
  staff         Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)

  // اسنپ‌شات اطلاعات در لحظه‌ی ثبت، تا حذف بعدی دسته/سرویس/پرسنل تاریخچه را از بین نبرد
  categoryName  String
  serviceName   String
  durationMinutes Int
  price         Int?
  staffName     String?

  date          DateTime      // فقط تاریخ روز نوبت (نیمه‌شب نرمال‌شده)
  startTime     String        // "HH:mm"
  endTime       String        // "HH:mm" - محاسبه‌شده از durationMinutes

  customerName  String
  customerPhone String

  depositAmount Int           @default(25000)
  depositStatus PaymentStatus @default(PENDING)
  authority     String?       @unique
  refId         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([staffId, date])
  @@index([status])
}