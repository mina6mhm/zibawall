generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  PENDING_PAYMENT
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderRole {
  USER
  ADMIN
}

enum GenderAudience {
  FEMALE
  MALE
  BOTH
}

enum AppointmentStatus {
  NEGOTIATING      // در حال گفتگو، هنوز زمان/آیتم نهایی نشده
  AWAITING_PAYMENT // سالن‌دار جزئیات را ثبت کرده، منتظر واریز مبلغ ثبت نوبت
  CONFIRMED        // مبلغ واریز شد، نوبت قطعی است
  CANCELLED        // لغو شده
}

enum AppointmentSender {
  CUSTOMER
  SALON
}

enum AppointmentMessageType {
  TEXT
  IMAGE
  VOICE
}

model Salon {
  id                    String      @id @default(uuid())
  name                  String
  province              String
  city                  String
  district              String?
  neighborhoods         String[]
  address               String
  lat                   Float?
  lng                   Float?
  phones                String[]
  workingHours          String
  closedDays            String[]

  hasHomeService         Boolean        @default(false)
  genderAudience         GenderAudience @default(BOTH)

  rating                Float       @default(0)
  reviewsCount          Int         @default(0)

  tags                  Json        @default("[]")
  imageUrl              String
  description           String
  portfolios            String[]

  status                SalonStatus @default(PENDING_PAYMENT)
  planId                String?
  subscriptionExpiresAt DateTime?
  reminderSentAt        DateTime?

  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  socials               Social?
  reviews               Review[]
  payments              Payment[]
  appointments          Appointment[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([status, subscriptionExpiresAt])
  @@index([hasHomeService])
  @@index([genderAudience])
}

model Social {
  id        String  @id @default(uuid())
  website   String?
  instagram String?
  whatsapp  String?
  telegram  String?
  rubika    String?
  bale      String?

  salonId   String  @unique
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Float
  comment   String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String?
  username      String?  @unique
  phone         String?  @unique
  email         String?  @unique

  passwordHash  String?

  role          String   @default("USER")

  otpCode       String?
  otpExpiresAt  DateTime?

  salon         Salon?

  supportMessages SupportMessage[]
  appointments    Appointment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  status    PaymentStatus @default(PENDING)
  planId    String

  authority String?       @unique
  refId     String?

  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SupportMessage {
  id          String        @id @default(uuid())
  message     String
  status      SupportStatus @default(PENDING)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  name        String?
  hadSalon    Boolean       @default(false)
  salonId     String?
  salonName   String?

  adminReply  String?
  repliedAt   DateTime?

  seenByUser  Boolean       @default(true)
  seenByAdmin Boolean       @default(true)

  replies     SupportReply[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([userId, seenByUser])
  @@index([seenByAdmin])
}

model SupportReply {
  id        String     @id @default(uuid())
  message   String
  sender    SenderRole

  ticketId  String
  ticket    SupportMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([ticketId])
}

// یک نوبت آنلاین: از گفتگوی اولیه شروع می‌شود، بعد از تایید سالن‌دار و واریز مبلغ ثبت نوبت قطعی می‌شود
model Appointment {
  id            String            @id @default(uuid())
  status        AppointmentStatus @default(NEGOTIATING)

  customerId    String
  customer      User              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  salonId       String
  salon         Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)

  visitDate     DateTime?
  checkInTime   String?
  checkOutTime  String?

  // هر آیتم: { name, price }
  services      Json              @default("[]")
  totalAmount   Int               @default(0)

  depositAmount Int               @default(20000)
  depositStatus PaymentStatus     @default(PENDING)
  authority     String?           @unique
  refId         String?

  messages      AppointmentMessage[]

  seenByCustomer Boolean          @default(true)
  seenBySalon    Boolean          @default(true)

  hiddenForCustomer Boolean       @default(false)
  hiddenForSalon    Boolean       @default(false)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([status])
  @@index([salonId, visitDate])
}

model AppointmentMessage {
  id            String                  @id @default(uuid())
  message       String?
  type          AppointmentMessageType  @default(TEXT)
  mediaUrl      String?
  duration      Int?                    // مدت زمان ویس به ثانیه

  sender        AppointmentSender

  replyToId     String?
  replyTo       AppointmentMessage?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       AppointmentMessage[]    @relation("MessageReplies")

  seenAt        DateTime?               // زمانی که طرف مقابل پیام رو دید (تیک آبی)

  appointmentId String
  appointment   Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime                @default(now())

  @@index([appointmentId])
  @@index([replyToId])
}