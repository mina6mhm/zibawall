generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  PENDING_PAYMENT
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderRole {
  USER
  ADMIN
}

enum GenderAudience {
  FEMALE
  MALE
  BOTH
}

enum BookingStatus {
  PENDING_PAYMENT // سالن‌دار نوبت رو باز کرده، منتظر واریز مشتریه
  CONFIRMED       // پرداخت انجام شد، نوبت قطعیه
  CANCELLED       // لغو شده
}

// نوبت از کجا ثبت شده: توسط خود مشتری از اپ، یا دستی توسط سالن‌دار
enum BookingSource {
  ONLINE
  MANUAL
}

model Salon {
  id                    String      @id @default(uuid())
  name                  String
  province              String
  city                  String
  district              String?
  neighborhoods         String[]
  address               String
  lat                   Float?
  lng                   Float?
  phones                String[]
  workingHours          String
  closedDays            String[]
  cardNumber            String

  hasHomeService         Boolean        @default(false)
  genderAudience         GenderAudience @default(BOTH)

  rating                Float       @default(0)
  reviewsCount          Int         @default(0)

  tags                  Json        @default("[]")
  imageUrl              String
  description           String
  portfolios            String[]

  status                SalonStatus @default(PENDING_PAYMENT)
  planId                String?
  subscriptionExpiresAt DateTime?
  reminderSentAt        DateTime?

  // نوبت‌دهی: کاملاً اختیاری و سمت سالن‌دار روشن/خاموش می‌شود
  bookingEnabled        Boolean     @default(false)

  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  socials               Social?
  reviews               Review[]
  payments              Payment[]
  visits                Visit[]

  bookings              Booking[]
  staff                 Staff[]

  // ساعات کاری هفتگی ساختاریافته + مسدودسازی‌های دستی (برای تقویم نوبت‌دهی)
  schedule              SalonSchedule[]
  timeBlocks            TimeBlock[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([status, subscriptionExpiresAt])
  @@index([hasHomeService])
  @@index([genderAudience])
}

model Social {
  id        String  @id @default(uuid())
  website   String?
  instagram String?
  whatsapp  String?
  telegram  String?
  rubika    String?
  bale      String?

  salonId   String  @unique
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Float
  comment   String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String?
  username      String?  @unique
  phone         String?  @unique
  email         String?  @unique

  passwordHash  String?

  role          String   @default("USER")

  otpCode       String?
  otpExpiresAt  DateTime?

  salon         Salon?

  supportMessages SupportMessage[]
  bookings        Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  status    PaymentStatus @default(PENDING)
  planId    String

  authority String?       @unique
  refId     String?

  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SupportMessage {
  id          String        @id @default(uuid())
  message     String
  status      SupportStatus @default(PENDING)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  name        String?
  hadSalon    Boolean       @default(false)
  salonId     String?
  salonName   String?

  adminReply  String?
  repliedAt   DateTime?

  seenByUser  Boolean       @default(true)
  seenByAdmin Boolean       @default(true)

  replies     SupportReply[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([userId, seenByUser])
  @@index([seenByAdmin])
}

model SupportReply {
  id        String     @id @default(uuid())
  message   String
  sender    SenderRole

  ticketId  String
  ticket    SupportMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([ticketId])
}

model Visit {
  id            String        @id @default(uuid())
  customerPhone String
  customerName  String?

  visitDate     DateTime
  checkInTime   String?
  checkOutTime  String?

  services      Json          @default("[]")
  totalAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  authority     String?       @unique
  refId         String?

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerPhone])
  @@index([paymentStatus])
}

// یک نوبت — یا توسط خود مشتری از اپ ثبت می‌شود (source: ONLINE)
// یا پس از توافق تلفنی/واتساپ/حضوری توسط سالن‌دار به‌صورت دستی ثبت می‌شود (source: MANUAL)
model Booking {
  id            String        @id @default(uuid())
  status        BookingStatus @default(PENDING_PAYMENT)
  source        BookingSource @default(MANUAL)

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // اگر شماره‌ی مشتری با یک یوزر ثبت‌نام‌شده مطابقت داشته باشد لینک می‌شود، وگرنه null
  customerId    String?
  customer      User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String?
  customerPhone String

  date          DateTime      // تاریخ نوبت (بدون ساعت)
  startTime     String        // ساعت نوبت، مثلاً "16:30"

  // کاملاً متنی و آزاد، امکان چند خدمت در یک نوبت.
  // هر آیتم می‌تواند duration (به دقیقه) هم داشته باشد؛ اگر نداشته باشد
  // (نوبت‌های قدیمی) سمت سرور یک مقدار پیش‌فرض ۳۰ دقیقه‌ای در نظر می‌گیرد.
  // نمونه: [{ "name": "کراتین مو", "price": 800000, "staffName": "سارا", "duration": 90 }]
  services      Json

  staffName     String?       // فیلد قدیمی/عمومی، فعلاً استفاده نمی‌شود (پرسنل داخل services ذخیره می‌شود)

  depositAmount Int           @default(0)     // بیعانه‌ی اختیاری، برای خود سالن
  appFee        Int           @default(20000) // هزینه‌ی ثابت اپ، اسنپ‌شات لحظه‌ی ساخت نوبت
  totalAmount   Int           // depositAmount + appFee ، مبلغی که مشتری واریز می‌کند

  paymentStatus PaymentStatus @default(PENDING)
  authority     String?       @unique
  refId         String?

  reminderSentAt DateTime?    // برای جلوگیری از ارسال تکراری پیامک یادآوری ۲۴ ساعته

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([salonId, date])
  @@index([paymentStatus])
  @@index([status])
}

// پرسنل سالن — برای یکسان‌سازی اسم پرسنل هنگام ثبت نوبت
model Staff {
  id        String   @id @default(uuid())
  name      String

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, name])
  @@index([salonId])
}

// ساعات کاری هفتگی ساختاریافته‌ی سالن.
// dayOfWeek بر اساس هفته‌ی شمسی: 0=شنبه، 1=یکشنبه، 2=دوشنبه، 3=سه‌شنبه،
// 4=چهارشنبه، 5=پنجشنبه، 6=جمعه — دقیقاً همون ترتیب آرایه‌ی
// WEEK_DAYS در components/business-form/constants.ts
model SalonSchedule {
  id        String  @id @default(uuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  isOpen    Boolean @default(true)
  openTime  String  @default("10:00")
  closeTime String  @default("20:00")

  @@unique([salonId, dayOfWeek])
  @@index([salonId])
}

// مسدودسازی دستی یک بازه‌ی زمانی خاص در یک روز خاص
// (مثلاً وقتی سالن‌دار مریض می‌شود و می‌خواهد چند ساعت را خالی نگه دارد)
model TimeBlock {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String
  endTime   String
  staffName String?  // اگر خالی باشد یعنی کل سالن مسدود است
  reason    String?
  createdAt DateTime @default(now())

  @@index([salonId, date])
}
