generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL // ثبت شده، منتظر تایید ادمین قبل از پابلیک شدن
  ACTIVE
  REJECTED         // ادمین ثبت را رد کرده است
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderRole {
  USER
  ADMIN
}

enum GenderAudience {
  FEMALE
  MALE
  BOTH
}

enum BookingStatus {
  PENDING_PAYMENT // سالن‌دار نوبت رو باز کرده، منتظر واریز مشتریه
  CONFIRMED       // پرداخت انجام شد، نوبت قطعیه
  CANCELLED       // لغو شده
}

model Salon {
  id                    String      @id @default(uuid())
  name                  String
  province              String
  city                  String
  district              String?
  neighborhoods         String[]
  address               String
  lat                   Float?
  lng                   Float?
  phones                String[]
  workingHours          String
  closedDays            String[]
  cardNumber            String
  schedule              SalonSchedule?
  bookingServices       BookingService[]

  hasHomeService         Boolean        @default(false)
  genderAudience         GenderAudience @default(BOTH)

  rating                Float       @default(0)
  reviewsCount          Int         @default(0)

  scheduleOverrides     SalonScheduleOverride[]

  tags                  Json        @default("[]")
  imageUrl              String
  description           String
  portfolios            String[]

  status                SalonStatus @default(PENDING_PAYMENT)
  rejectionReason       String?     // در صورت رد شدن توسط ادمین، دلیل به سالن‌دار نشان داده می‌شود
  reviewedAt            DateTime?   // زمانی که ادمین تایید یا رد کرد
  planId                String?
  subscriptionExpiresAt DateTime?
  reminderSentAt        DateTime?

  // نوبت‌دهی: کاملاً اختیاری و سمت سالن‌دار روشن/خاموش می‌شود
  bookingEnabled        Boolean     @default(false)

  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  socials               Social?
  reviews               Review[]
  payments              Payment[]
  visits                Visit[]

  bookings              Booking[]
  bookingGroups         BookingGroup[]
  staff                 Staff[]
  managers              SalonManager[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([status, subscriptionExpiresAt])
  @@index([hasHomeService])
  @@index([genderAudience])
}

// شماره‌موبایل‌هایی که سالن‌دار به‌عنوان «مدیر سالن» اضافه کرده است.
// هر کاربری که با این شماره لاگین کند، دقیقاً همان دسترسی صاحب سالن را
// به تنظیمات، نوبت‌ها، پرسنل و ... خواهد داشت (بجز حذف کسب‌وکار و مدیریت خود این لیست).
model SalonManager {
  id        String   @id @default(uuid())
  phone     String
  label     String?  // یادداشت اختیاری خودِ صاحب سالن، مثلاً «منشی سارا» — فقط نمایشی

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, phone])
  @@index([salonId])
  @@index([phone])
}

model Social {
  id        String  @id @default(uuid())
  website   String?
  instagram String?
  whatsapp  String?
  telegram  String?
  rubika    String?
  bale      String?

  salonId   String  @unique
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Float
  comment   String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String?
  username      String?  @unique
  phone         String?  @unique
  email         String?  @unique

  passwordHash  String?

  role          String   @default("USER")

  otpCode       String?
  otpExpiresAt  DateTime?

  salon         Salon?

  supportMessages SupportMessage[]
  bookings        Booking[]
  bookingGroups   BookingGroup[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  status    PaymentStatus @default(PENDING)
  planId    String

  authority String?       @unique
  refId     String?

  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SupportMessage {
  id          String        @id @default(uuid())
  message     String
  status      SupportStatus @default(PENDING)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  name        String?
  hadSalon    Boolean       @default(false)
  salonId     String?
  salonName   String?

  adminReply  String?
  repliedAt   DateTime?

  seenByUser  Boolean       @default(true)
  seenByAdmin Boolean       @default(true)

  replies     SupportReply[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([userId, seenByUser])
  @@index([seenByAdmin])
}

model SupportReply {
  id        String     @id @default(uuid())
  message   String
  sender    SenderRole

  ticketId  String
  ticket    SupportMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([ticketId])
}

model Visit {
  id            String        @id @default(uuid())
  customerPhone String
  customerName  String?

  visitDate     DateTime
  checkInTime   String?
  checkOutTime  String?

  services      Json          @default("[]")
  totalAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  authority     String?       @unique
  refId         String?

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerPhone])
  @@index([paymentStatus])
}

// یک گروه از رزروهای آنلاینی که مشتری در یک سبد با هم ثبت کرده — پرداخت
// بیعانه‌ها و هزینه‌ی پلتفرم فقط یک‌بار، روی کل گروه انجام می‌شود
model BookingGroup {
  id            String        @id @default(uuid())

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  customerId    String?
  customer      User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone String
  customerName  String?

  totalDeposit  Int           @default(0)
  appFee        Int           @default(20000)
  totalAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  expiresAt     DateTime?
  authority     String?       @unique
  refId         String?

  bookings      Booking[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerId])
}

// یک نوبت دستی که سالن‌دار پس از توافق تلفنی/واتساپ/تلگرام با مشتری ثبت می‌کند
model Booking {
  id            String        @id @default(uuid())
  status        BookingStatus @default(PENDING_PAYMENT)

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // اگر شماره‌ی مشتری با یک یوزر ثبت‌نام‌شده مطابقت داشته باشد لینک می‌شود، وگرنه null
  customerId    String?
  customer      User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String?
  customerPhone String

  date          DateTime      // تاریخ نوبت (بدون ساعت)
  startTime     String        // ساعت نوبت، مثلاً "16:30"

  // کاملاً متنی و آزاد، امکان چند خدمت در یک نوبت
  // نمونه: [{ "name": "کراتین مو", "price": 800000 }, { "name": "میکاپ عروس", "price": 500000 }]
  services      Json

  staffName     String?       // اسم پرسنل، اختیاری و آزاد

  depositAmount Int           @default(0)     // بیعانه‌ی اختیاری، برای خود سالن
  appFee        Int           @default(20000) // هزینه‌ی ثابت اپ، اسنپ‌شات لحظه‌ی ساخت نوبت
  totalAmount   Int           // depositAmount + appFee ، مبلغی که مشتری واریز می‌کند

  paymentStatus PaymentStatus @default(PENDING)
  expiresAt     DateTime?
  authority     String?       @unique
  refId         String?

  reminderSentAt DateTime?    // برای جلوگیری از ارسال تکراری پیامک یادآوری ۲۴ ساعته

  // اگر این نوبت بخشی از یک سبد چند-خدمتی رزرو آنلاین باشد، به گروهش وصل می‌شود
  // null یعنی نوبت تکی یا نوبت‌های قدیمی قبل از این تغییر
  bookingGroupId String?
  bookingGroup   BookingGroup? @relation(fields: [bookingGroupId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([salonId, date])
  @@index([paymentStatus])
  @@index([status])
  @@index([bookingGroupId])
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  offDays   String[] @default([]) // روزهای ثابت تعطیل: ["شنبه", "جمعه"]
  
  bookingServices   StaffBookingService[]
  scheduleOverrides StaffScheduleOverride[]

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, name])
  @@unique([salonId, phone])
  @@index([salonId])
}

model BookingService {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name          String
  durationMin   Int      // مدت به دقیقه، مثلاً 90
  price         Int      // قیمت کل
  isActive      Boolean  @default(true)
  staffMembers  StaffBookingService[]
  createdAt     DateTime @default(now())

  @@index([salonId])
}

// رابطه چند به چند: هر پرسنل چه خدماتی انجام می‌دهد
model StaffBookingService {
  staffId           String
  staff             Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  bookingServiceId  String
  bookingService    BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)

  @@id([staffId, bookingServiceId])
}

// برنامه هفتگی پیش‌فرض سالن + تنظیمات Grid
model SalonSchedule {
  id            String   @id @default(uuid())
  salonId       String   @unique
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  // هر روز هفته: آیا کاری است و ساعت شروع/پایان
  // ذخیره به صورت JSON: { "شنبه": { open: true, start: "09:00", end: "20:00" }, ... }
  weeklySchedule Json    @default("{}")
  
  gridMinutes   Int      @default(30) // فاصله شروع نوبت‌ها: 15، 30، یا 60
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// override دستی برای یک پرسنل در یک تاریخ مشخص
model StaffScheduleOverride {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  date      String   // "2025-08-15" — تاریخ میلادی
  
  isDayOff  Boolean  @default(false)  // مرخصی کامل
  start     String?  // ساعت شروع اختصاصی، مثلاً "10:00"
  end       String?  // ساعت پایان اختصاصی
  note      String?  // دلیل: مرخصی، بیماری، ...
  
  createdAt DateTime @default(now())

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

// override دستی برای یک تاریخ خاص از خود سالن
model SalonScheduleOverride {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  date      String   // "2025-08-15" — تاریخ میلادی

  isClosed  Boolean  @default(true)  // تعطیلی کامل سالن در این روز
  start     String?  // اگر تعطیل نیست ولی ساعت کاری آن روز فرق دارد
  end       String?
  note      String?  // مثلاً: تعطیلی رسمی، تعمیرات، ...

  createdAt DateTime @default(now())

  @@unique([salonId, date])
  @@index([salonId])
  @@index([date])
}