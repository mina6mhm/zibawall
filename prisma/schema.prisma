generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalonStatus {
  PENDING_PAYMENT
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SenderRole {
  USER
  ADMIN
}

enum GenderAudience {
  FEMALE
  MALE
  BOTH
}

enum BookingStatus {
  PENDING_PAYMENT // سالن‌دار نوبت رو باز کرده، منتظر واریز مشتریه
  CONFIRMED       // پرداخت انجام شد، نوبت قطعیه
  CANCELLED       // لغو شده
}

model Salon {
  id                    String      @id @default(uuid())
  name                  String
  province              String
  city                  String
  district              String?
  neighborhoods         String[]
  address               String
  lat                   Float?
  lng                   Float?
  phones                String[]
  workingHours          String
  closedDays            String[]
  cardNumber            String

  hasHomeService         Boolean        @default(false)
  genderAudience         GenderAudience @default(BOTH)

  rating                Float       @default(0)
  reviewsCount          Int         @default(0)

  tags                  Json        @default("[]")
  imageUrl              String
  description           String
  portfolios            String[]

  status                SalonStatus @default(PENDING_PAYMENT)
  planId                String?
  subscriptionExpiresAt DateTime?
  reminderSentAt        DateTime?

  // نوبت‌دهی: کاملاً اختیاری و سمت سالن‌دار روشن/خاموش می‌شود
  bookingEnabled        Boolean     @default(false)

  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  socials               Social?
  reviews               Review[]
  payments              Payment[]
  visits                Visit[]

  bookings              Booking[]
  staff                 Staff[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([status, subscriptionExpiresAt])
  @@index([hasHomeService])
  @@index([genderAudience])
}

model Social {
  id        String  @id @default(uuid())
  website   String?
  instagram String?
  whatsapp  String?
  telegram  String?
  rubika    String?
  bale      String?

  salonId   String  @unique
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Float
  comment   String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  name          String?
  username      String?  @unique
  phone         String?  @unique
  email         String?  @unique

  passwordHash  String?

  role          String   @default("USER")

  otpCode       String?
  otpExpiresAt  DateTime?

  salon         Salon?

  supportMessages SupportMessage[]
  bookings        Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  status    PaymentStatus @default(PENDING)
  planId    String

  authority String?       @unique
  refId     String?

  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SupportMessage {
  id          String        @id @default(uuid())
  message     String
  status      SupportStatus @default(PENDING)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone       String?
  name        String?
  hadSalon    Boolean       @default(false)
  salonId     String?
  salonName   String?

  adminReply  String?
  repliedAt   DateTime?

  seenByUser  Boolean       @default(true)
  seenByAdmin Boolean       @default(true)

  replies     SupportReply[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([userId, seenByUser])
  @@index([seenByAdmin])
}

model SupportReply {
  id        String     @id @default(uuid())
  message   String
  sender    SenderRole

  ticketId  String
  ticket    SupportMessage @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())

  @@index([ticketId])
}

model Visit {
  id            String        @id @default(uuid())
  customerPhone String
  customerName  String?

  visitDate     DateTime
  checkInTime   String?
  checkOutTime  String?

  services      Json          @default("[]")
  totalAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  authority     String?       @unique
  refId         String?

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerPhone])
  @@index([paymentStatus])
}

// یک نوبت دستی که سالن‌دار پس از توافق تلفنی/واتساپ/تلگرام با مشتری ثبت می‌کند
model Booking {
  id            String        @id @default(uuid())
  status        BookingStatus @default(PENDING_PAYMENT)

  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // اگر شماره‌ی مشتری با یک یوزر ثبت‌نام‌شده مطابقت داشته باشد لینک می‌شود، وگرنه null
  customerId    String?
  customer      User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String?
  customerPhone String

  date          DateTime      // تاریخ نوبت (بدون ساعت)
  startTime     String        // ساعت نوبت، مثلاً "16:30"

  // کاملاً متنی و آزاد، امکان چند خدمت در یک نوبت
  // نمونه: [{ "name": "کراتین مو", "price": 800000 }, { "name": "میکاپ عروس", "price": 500000 }]
  services      Json

  staffName     String?       // اسم پرسنل، اختیاری و آزاد

  depositAmount Int           @default(0)     // بیعانه‌ی اختیاری، برای خود سالن
  appFee        Int           @default(20000) // هزینه‌ی ثابت اپ، اسنپ‌شات لحظه‌ی ساخت نوبت
  totalAmount   Int           // depositAmount + appFee ، مبلغی که مشتری واریز می‌کند

  paymentStatus PaymentStatus @default(PENDING)
  authority     String?       @unique
  refId         String?

  reminderSentAt DateTime?    // برای جلوگیری از ارسال تکراری پیامک یادآوری ۲۴ ساعته

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([customerId])
  @@index([salonId, date])
  @@index([paymentStatus])
  @@index([status])
}

// پرسنل سالن — برای یکسان‌سازی اسم پرسنل هنگام ثبت نوبت
model Staff {
  id        String   @id @default(uuid())
  name      String
  phone     String?

  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([salonId, name])
  @@unique([salonId, phone])
  @@index([salonId])
}